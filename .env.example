QydhaApiBase=https://qydha-api-staging.sam-baloot-admin.online
QydhaToken=
PLAYER_PASSWORD=
TOURNAMENT_ID=4c78cd9a-9d4e-4b33-94e3-def23ae07a92
JOIN_USER_PREFIX=user
JOIN_USER_START=1
JOIN_USER_END=16
# Optional if the tournament requires a qualification place
QUALIFICATION_PLACE_ID=
# Staging rate-limits POST /auth/login — wait between team captains
LOGIN_GAP_MS=15000
LOGIN_MAX_RETRIES=6
# To finish remaining users only, e.g. JOIN_USER_START=15 JOIN_USER_END=16
# teammate must accept before organizer sees the request
TEAMMATE_ACTION=accept
# all | create | teammate  (teammate = only accept/reject existing invites)
JOIN_PHASE=all
