QydhaApiBase=https://qydha-api-staging.sam-baloot-admin.online
QydhaToken=
PLAYER_PASSWORD=
# Admin used to GET /tournaments/{id}/places for random join place
ADMIN_USERNAME=
ADMIN_PASSWORD=
TOURNAMENT_ID=4c78cd9a-9d4e-4b33-94e3-def23ae07a92
JOIN_USER_PREFIX=user
JOIN_USER_START=1
JOIN_USER_END=16
# Optional: when a team selects a place, force this id (else random from GET /places)
QUALIFICATION_PLACE_ID=
# 0..1 share of teams that select a place; rest omit (no preference). Default 0.5
JOIN_WITH_PLACE_RATIO=0.5
# Parallel teams at once (0 = all). Lower if login returns 429.
JOIN_CONCURRENCY=0
# Optional delay between starting each team worker (ms)
JOIN_STAGGER_MS=0
# Wait inside a team before teammate login (after captain create)
LOGIN_GAP_MS=15000
LOGIN_MAX_RETRIES=6
# To finish remaining users only, e.g. JOIN_USER_START=15 JOIN_USER_END=16
# teammate must accept before organizer sees the request
TEAMMATE_ACTION=accept
# all | create | teammate  (teammate = only accept/reject existing invites)
JOIN_PHASE=all
